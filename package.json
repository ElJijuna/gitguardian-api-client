{
    "name": "gitguardian-api-client",
    "version": "1.0.0",
    "type": "module",
    "description": "A lightweight TypeScript client for the GitGuardian REST API with zero runtime dependencies.",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "check": "npm run lint && npm run typecheck && npm test && npm run build",
        "docs": "typedoc",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:client": "npm run build && node test-client/test.js",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "gitguardian",
        "api",
        "client",
        "secrets",
        "security",
        "honeytokens",
        "incidents",
        "scanning",
        "rest",
        "typescript"
    ],
    "engines": {
        "node": ">=18"
    },
    "license": "MIT",
    "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
    "homepage": "https://eljijuna.github.io/gitguardian-api-client",
    "bugs": {
        "url": "https://github.com/ElJijuna/gitguardian-api-client/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ElJijuna/gitguardian-api-client.git"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.9",
        "eslint": "^10.10.0",
        "jest": "^29.7.0",
        "semantic-release": "^25.0.3",
        "super-configs": "^1.13.0",
        "ts-jest": "^29.3.0",
        "ts-node": "^10.9.2",
        "tsup": "^8.4.0",
        "typedoc": "^0.28.0",
        "typescript": "^5.8.2"
    }
}
